      "source": [
        "import os\n",
        "\n",
        "# Create a directory to store the dataset if it doesn't exist\n",
        "if not os.path.exists('eegmat'):\n",
        "    os.makedirs('eegmat')\n",
        "\n",
        "# Change to the new directory to download files there\n",
        "os.chdir('eegmat')\n",
        "\n",
        "# Download the dataset using wget with the specified parameters\n",
        "!wget -r -N -c -np https://physionet.org/files/eegmat/1.0.0/\n",
        "\n",
        "# Change back to the original directory\n",
        "os.chdir('..')\n",
        "\n",
        "print(\"EEG dataset download initiated.\")"
