    {
      "cell_type": "markdown",
      "metadata": {
        "id": "b705947c"
      },
      "source": [
        "**Reasoning**:\n",
        "I need to redefine the `process_eeg_for_gamma_power` function as per the instructions, incorporating epoching and calculating mean power spectral density (PSD) within the gamma band for each channel. This will update the previous function definition to align with the new requirements.\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "f47915e7",
        "outputId": "3b34e680-3771-48c4-b0c9-3daff04176c4"
      },
      "source": [
        "import mne\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "def process_eeg_for_gamma_power(edf_file_path, l_freq=30, h_freq=100, exclude_channels=['ECG ECG', 'EEG A2-A1'], epoch_length_sec=1.0):\n",
        "    \"\"\"\n",
        "    Loads an EDF file, applies a bandpass filter to isolate gamma wave activity,\n",
        "    splits data into fixed-length epochs, and calculates the mean power spectral density\n",
        "    within the gamma band (30-100 Hz) averaged across these epochs for each relevant EEG channel.\n",
        "\n",
        "    Args:\n",
        "        edf_file_path (str): Path to the EDF file.\n",
        "        l_freq (int): Lower frequency bound for the gamma band (default: 30 Hz).\n",
        "        h_freq (int): Upper frequency bound for the gamma band (default: 100 Hz).\n",
        "        exclude_channels (list, optional): List of channel names to exclude.\n",
        "        epoch_length_sec (float): Duration of each epoch in seconds (default: 1.0).\n",
        "\n",
        "    Returns:\n",
        "        pandas.Series: A Series containing mean gamma PSD for each channel.\n",
        "    \"\"\"\n",
        "    try:\n",
        "        # Load the EDF file\n",
        "        raw = mne.io.read_raw_edf(edf_file_path, preload=True, verbose=False)\n",
        "\n",
        "        # Drop specified channels if any\n",
        "        if exclude_channels:\n",
        "            raw.drop_channels(exclude_channels, on_missing='ignore')\n",
        "\n",
        "        # Create fixed-length events\n",
        "        # Events will mark the start of each epoch\n",
        "        events = mne.make_fixed_length_events(raw, duration=epoch_length_sec, overlap=0)\n",
        "\n",
        "        # Create epochs from the raw data and events\n",
        "        # tmin=0, tmax=epoch_length_sec - 1/sfreq ensures epochs don't overlap\n",
        "        epochs = mne.Epochs(raw, events, tmin=0, tmax=epoch_length_sec - 1/raw.info['sfreq'],\n",
        "                            baseline=None, preload=True, verbose=False)\n",
        "\n",
        "        # Compute the Power Spectral Density (PSD) for each epoch\n",
        "        spectrum = epochs.compute_psd(method='welch', fmin=l_freq, fmax=h_freq, verbose=False)\n",
        "\n",
        "        # Extract power values. The output is (n_epochs, n_channels, n_frequencies)\n",
        "        power = spectrum.get_data()\n",
        "\n",
        "        # Average power across frequencies within the gamma band\n",
        "        # Then average across all epochs to get one value per channel\n",
        "        mean_gamma_psd_per_channel = np.mean(power, axis=(0, 2)) # Average over epochs (axis 0) and frequencies (axis 2)\n",
        "\n",
        "        # Create a pandas Series for better readability\n",
        "        gamma_psd_series = pd.Series(mean_gamma_psd_per_channel, index=epochs.ch_names)\n",
        "\n",
        "        return gamma_psd_series\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"Error processing {edf_file_path}: {e}\")\n",
        "        return None\n",
        "\n",
        "print(\"Function `process_eeg_for_gamma_power` redefined with epoching and PSD calculation.\")"
      ],
