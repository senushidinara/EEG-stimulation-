      },
      "source": [
        "import statsmodels.api as sm\n",
        "from statsmodels.formula.api import ols\n",
        "import pandas as pd\n",
        "\n",
        "# Initialize a list to store ANOVA results for each channel\n",
        "anova_results_rm = []\n",
        "\n",
        "# Get unique channels from the long format DataFrame\n",
        "unique_channels = long_df_for_anova['Channel'].unique()\n",
        "\n",
        "print(\"Performing Two-Way Repeated Measures ANOVA for each channel...\")\n",
        "\n",
        "for channel in unique_channels:\n",
        "    # Filter data for the current channel\n",
        "    channel_data = long_df_for_anova[long_df_for_anova['Channel'] == channel]\n",
        "\n",
        "    # Ensure 'Subject' and 'Group' are treated as categorical variables if not already\n",
        "    channel_data['Subject_Factor'] = channel_data['Subject'].astype('category')\n",
        "    channel_data['Group_Factor'] = channel_data['Group'].astype('category')\n",
        "\n",
        "    # Perform repeated measures ANOVA\n",
        "    # GammaPower ~ C(Condition) * C(Group) + C(Subject_Factor)\n",
        "    # Subject_Factor is treated as a random effect, but for AnovaRM it's the 'within' subject ID\n",
        "    # The interaction between Group and Condition is what we are primarily interested in.\n",
        "    try:\n",
        "        aov = sm.stats.anova_lm(ols('GammaPower ~ C(Condition) * C(Group_Factor)', data=channel_data).fit(), typ=2)\n",
        "\n",
        "        # For repeated measures, we typically use AnovaRM (ANOVA for Repeated Measures)\n",
        "        # It requires `Subject` as the subject identifier, `within` factors (Condition), and `between` factors (Group).\n",
        "        # Note: AnovaRM is designed for within-subject factors, and can handle between-subject factors.\n",
        "        # The formula should reflect this structure.\n",
        "\n",
        "        # Prepare data for AnovaRM: needs subject column, within-subject columns, and between-subject columns\n",
        "        # long_df_for_anova already has Subject, Group, Condition, GammaPower\n",
        "\n",
        "        # AnovaRM requires a specific structure, let's use the formula approach directly for consistency\n",
        "        # with the stated task of two-way RM ANOVA on GammaPower with Condition (within) and Group (between).\n",
        "\n",
        "        # Manually extract factors for AnovaRM (if needed, otherwise OLS + anova_lm is often used for mixed models)\n",
        "        # For true repeated measures ANOVA using `AnovaRM`, subject should be unique for each group across conditions.\n",
        "        # However, here each subject is measured twice (Before/After) and belongs to one Group.\n",
        "        # The standard approach for this kind of mixed design (one within, one between) is often via mixed models (LMM) or ANOVA from OLS.\n",
        "\n",
        "        # The request specifically asks for a two-way repeated-measures ANOVA,\n",
        "        # which implies looking at within-subject (Condition) and between-subject (Group) effects.\n",
        "        # statsmodels.formula.api.ols followed by anova_lm can handle this by treating Subject as fixed or random implicitly in some forms,\n",
        "        # or more robustly with MixedLM, but simpler interpretation comes from AnovaRM for balanced designs.\n",
        "\n",
        "        # Let's use AnovaRM for a clearer repeated measures approach, ensuring proper handling of subject IDs.\n",
        "        # We need to specify `Subject` as the subject identifier.\n",
        "        aov_rm = sm.stats.anova_single(channel_data,\n",
        "                                      depvar='GammaPower',\n",
        "                                      subjec = 'Subject_Factor',\n",
        "                                      within = 'Condition',\n",
        "                                      between = 'Group_Factor',\n",
        "                                      type=2)\n",
        "\n",
        "        # Extract relevant p-values and F-statistics from AnovaRM output\n",
        "        p_group = aov_rm.loc['Group_Factor', 'p-value']\n",
        "        p_condition = aov_rm.loc['Condition', 'p-value']\n",
        "        p_interaction = aov_rm.loc['Group_Factor:Condition', 'p-value']\n",
        "\n",
        "        f_group = aov_rm.loc['Group_Factor', 'F']\n",
        "        f_condition = aov_rm.loc['Condition', 'F']\n",
        "        f_interaction = aov_rm.loc['Group_Factor:Condition', 'F']\n",
        "\n",
        "        anova_results_rm.append({\n",
        "            'Channel': channel,\n",
        "            'F_Group': f_group,\n",
        "            'p_Group': p_group,\n",
        "            'F_Condition': f_condition,\n",
        "            'p_Condition': p_condition,\n",
        "            'F_Interaction': f_interaction,\n",
        "            'p_Interaction': p_interaction\n",
        "        })\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"Could not perform ANOVA for channel {channel}: {e}\")\n",
        "\n",
        "# Convert results to DataFrame\n",
        "anova_rm_df = pd.DataFrame(anova_results_rm)\n",
        "\n",
        "# Display the ANOVA results\n",
        "print(\"\\n--- Two-Way Repeated Measures ANOVA Results ---\\n\")\n",
        "print(anova_rm_df)\n",
        "print(\"\\nTwo-way repeated-measures ANOVA performed for all relevant EEG channels.\")"
