        "outputId": "73d39564-47e6-4b07-aace-d6fc0dcc164e"
      },
      "source": [
        "import mne\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "def process_eeg_for_gamma_power(edf_file_path, l_freq=30, h_freq=100, exclude_channels=None):\n",
        "    \"\"\"\n",
        "    Loads an EDF file, applies a bandpass filter for gamma waves, and calculates\n",
        "    a representative measure of gamma power for each relevant EEG channel.\n",
        "\n",
        "    Args:\n",
        "        edf_file_path (str): Path to the EDF file.\n",
        "        l_freq (int): Lower frequency bound for the gamma band (default: 30 Hz).\n",
        "        h_freq (int): Upper frequency bound for the gamma band (default: 100 Hz).\n",
        "        exclude_channels (list, optional): List of channel names to exclude.\n",
        "\n",
        "    Returns:\n",
        "        pandas.Series: A Series containing gamma power for each channel.\n",
        "    \"\"\"\n",
        "    try:\n",
        "        # Load the EDF file\n",
        "        raw = mne.io.read_raw_edf(edf_file_path, preload=True, verbose=False)\n",
        "\n",
        "        # Drop specified channels if any\n",
        "        if exclude_channels:\n",
        "            raw.drop_channels(exclude_channels, on_missing='ignore')\n",
        "\n",
        "        # Apply bandpass filter for gamma waves\n",
        "        raw.filter(l_freq, h_freq, fir_design='firwin', verbose=False)\n",
        "\n",
        "        # Extract filtered data\n",
        "        # The data is typically in Volts, so we don't need to scale it for power calculation based on amplitude\n",
        "        filtered_data = raw.get_data()\n",
        "\n",
        "        # Calculate gamma power for each channel\n",
        "        # A simple measure of power here is the mean of the absolute values of the filtered signal\n",
        "        gamma_power_per_channel = np.mean(np.abs(filtered_data), axis=1)\n",
        "\n",
        "        # Create a pandas Series for better readability\n",
        "        gamma_power_series = pd.Series(gamma_power_per_channel, index=raw.ch_names)\n",
        "\n",
        "        return gamma_power_series\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"Error processing {edf_file_path}: {e}\")\n",
        "        return None\n",
        "\n",
        "print(\"Function `process_eeg_for_gamma_power` defined.\")\n"
      ],
